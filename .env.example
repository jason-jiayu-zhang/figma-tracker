# Copy to `.env` and fill in your own values. Never commit the filled-in file.

PORT=3001

# Supabase — service_role key, server-side only (never expose to the browser)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Figma OAuth app
FIGMA_CLIENT_ID=your_figma_client_id
FIGMA_CLIENT_SECRET=your_figma_client_secret
FIGMA_OAUTH_REDIRECT_URI=http://localhost:5173/api/oauth/callback

# Public origin the app is served from. Used for CORS, cookie Secure detection,
# and the post-OAuth redirect.
APP_URL=http://localhost:5173

# Secrets — generate each with: openssl rand -hex 32
# TOKEN_ENCRYPTION_KEY must be >=32 chars; the server refuses to start without it,
# and changing it makes already-encrypted Figma tokens undecryptable.
SESSION_SECRET=replace_me_with_a_random_32_byte_hex_string
TOKEN_ENCRYPTION_KEY=replace_me_with_a_random_32_byte_hex_string

# Authorizes the cron-driven sync endpoints. When unset those endpoints reject
# every request, so an external scheduler needs this set.
CRON_SECRET=

# Must match the passcode used when creating the Figma webhook subscription.
# When unset, every delivery to POST /api/webhook is rejected with 401.
FIGMA_WEBHOOK_PASSCODE=

# Set to `off` when an external scheduler drives sync instead of the in-process loop.
RESIDENT_SYNC=

# Local dev only: unlocks GET /api/oauth/dev-login to bypass Figma OAuth on localhost.
# Leave unset or 0 in production.
DEV_LOGIN=1

# Frontend build-time vars (Vite). These are baked into the public JS bundle at
# build time — never put a secret behind a VITE_ prefix.
# Set only when the API is hosted on a different origin than the SPA.
VITE_API_URL=
# Contact address shown on the legal pages and in the footer.
VITE_CONTACT_EMAIL=you@example.com
