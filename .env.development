# Local dev only (Vite loads this in `vite dev`, never in production builds).
# VITE_IS_APP=1 forces dashboard "app mode" so /onboard, /studio, /files, etc.
# are reachable on localhost. Set to 0 ONLY to preview the marketing Landing
# page at / — in that mode every route (including /studio) falls back to
# Landing, so the app pages and the post-OAuth "Open Studio" button won't work.
VITE_IS_APP=1
